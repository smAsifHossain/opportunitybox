# Normalize line endings: LF in the repository and in working copies,
# so Windows/macOS/Linux contributors produce identical diffs.
* text=auto eol=lf

# Binary files — never convert
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

# Generated files: collapse in pull request diffs
package-lock.json linguist-generated=true
