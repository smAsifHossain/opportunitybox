# PostgreSQL connection string.
# Local dev (docker compose up -d): postgresql://postgres:postgres@localhost:5432/opportunitybox
# Production: a free Neon (neon.tech) or Supabase connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/opportunitybox"

# Auth.js secret, generate with: npx auth secret
AUTH_SECRET=""

# Base URL of the app (used in emails and metadata)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Google OAuth login. Leave empty to disable the Google button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email. Pick one of the two, or neither.
#
# Option 1, any SMTP provider. Most free tiers let you verify a single
# sender address, so you do not need to own a domain. Host and port for the
# common ones:
#   Brevo     smtp-relay.brevo.com   587   300 emails/day free
#   Mailjet   in-v3.mailjet.com      587   200/day, 6000/month free
#   SMTP2GO   mail.smtp2go.com       587   1000/month free
#   Gmail     smtp.gmail.com         587   needs an App Password
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
#
# Gmail shortcut. Set these two instead of the four above and the host and
# port are filled in for you. Needs 2 Step Verification on the Google account
# and an App Password from myaccount.google.com/apppasswords.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
#
# Option 2, Resend (resend.com). Only delivers to your own address until you
# verify a domain you own.
RESEND_API_KEY=""
#
# The sender recipients see. Must be an address your provider has verified.
EMAIL_FROM="OpportunityBox <you@example.com>"
#
# With neither configured, emails are printed to the console instead of sent,
# which is usually what you want locally.

# Shared secret protecting cron endpoints (/api/ingest, /api/newsletter/digest).
# Generate any long random string.
CRON_SECRET=""
